PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase → Project Settings → Database → Connection string (session pooler)
DATABASE_URL=
# Supabase → Project Settings → API
SUPABASE_URL=
# Server-only secret. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Leave empty until the Paystack merchant account is approved (test key is fine for dev)
PAYSTACK_SECRET_KEY=
